# EncroWatch AI - Version Control Ignore Rules

# Environment variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Local Database Files & Fallbacks
backend/data/*.json
!backend/data/.gitkeep
data/*.json

# Backups & Archives
backups/
*.zip
*.tar.gz
*.bak

# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node & Frontend Build
frontend/node_modules/
node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Uploads & Media (Preserve folder structure, exclude raw uploads)
backend/uploads/original/*
backend/uploads/annotated/*
backend/uploads/privacy/*
backend/uploads/inspections/*
backend/uploads/reports/*
!backend/uploads/**/.gitkeep
!backend/uploads/original/clear_street.jpg

# OS & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker Logs
*.log

# AI Model Backups
backend/app/ai/weights/backups/

# Local Scratch / Prompt Dumps
current_task_prompt.txt
scratch_prompt.txt
