# ==============================================================================
# EncroWatch AI — Production & Deployment Environment Configuration Template
# NOTE: Copy this file to '.env' and populate with production secrets.
# NEVER commit the active '.env' file containing secrets to version control.
# Generate production keys using: python scripts/generate_secret_key.py
# ==============================================================================

# Application Environment
# Options: 'production', 'staging', 'development'
ENVIRONMENT=production

# Ingress & Networking Ports
PORT=80
FRONTEND_PORT=80
BACKEND_INTERNAL_PORT=8000
HOST=0.0.0.0

# Cryptographic Authentication & Security
# Generate a cryptographically strong 256-bit key (e.g. `python scripts/generate_secret_key.py`)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
# Production JWT expiration: 1440 minutes = 24 hours (use shorter with refresh tokens if required)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo Persona Switcher (MUST be false in production)
ALLOW_DEMO_SWITCH=false

# Persistence Configuration (MongoDB)
# In Docker Compose internal network: mongodb://mongodb:27017
# With MongoDB authentication enabled: mongodb://<username>:<password>@mongodb:27017/encrowatch_ai_db?authSource=admin
# On Managed Cloud (MongoDB Atlas / AWS DocumentDB): mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGODB_URI=mongodb://mongodb:27017
DATABASE_NAME=encrowatch_ai_db

# Optional MongoDB Root Authentication (for production database container initialization)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=GENERATE_SECURE_PASSWORD_WITH_SCRIPT

# CORS Allowed Origins (Comma-separated exact domains)
# In production, set to your exact domain(s) e.g. https://encrowatch.city.gov
# Wildcard '*' is strictly prohibited in production when credentials are enabled.
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com

# Media & Document Storage (Local or mounted EBS/EFS volume)
UPLOAD_DIR=/app/uploads

# Default Municipal Geolocation Center (Bengaluru City Center default)
DEFAULT_LAT=12.9716
DEFAULT_LNG=77.5946

# AI Pipeline Weights Configuration
YOLO_WEIGHTS_PATH=/app/app/ai/weights/yolov5n.onnx
ALLOW_DEMO_MODE=false
